# --- Core ---
NODE_ENV=development
PORT=5000

# MongoDB connection string (was MongoDB_URI, still accepted as a fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/ecorecycle

# --- Auth ---
# Required. Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10

# --- CORS: comma-separated list of allowed browser origins ---
CORS_ORIGINS=http://localhost:5173,https://eco-recycle-rho.vercel.app

# --- Third-party: nearby recycling centre search ---
GOMAPS_PRO_API_KEY=

# --- Mail (optional; without it, OTP codes are written to the log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoRecycle <no-reply@ecorecycle.app>
CONTACT_TO=

# --- Rate limits (requests per window); defaults shown ---
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_LOCATION_MAX=20

# --- Logging: silent | error | warn | info | debug ---
LOG_LEVEL=info
